{
  "name": "johnnyxlemonade/admin-cms-news",
  "description": "Reusable localized CMS news module for Lemonade Admin.",
  "type": "library",
  "license": "Apache-2.0",
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/johnnyxlemonade/framework"
    },
    {
      "type": "vcs",
      "url": "https://github.com/johnnyxlemonade/admin-platform"
    }
  ],
  "require": {
    "php": ">=8.3 <8.6",
    "johnnyxlemonade/framework": "dev-master",
    "johnnyxlemonade/admin-platform": "dev-main",
    "psr/http-message": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "Lemonade\\Cms\\News\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Lemonade\\Cms\\News\\Tests\\": "tests/"
    }
  },
  "extra": {
    "lemonade": {
      "modules": [
        "Lemonade\\Cms\\News\\ModuleManifest"
      ]
    }
  },
  "scripts": {
    "cs:check": "@php vendor/bin/php-cs-fixer fix --dry-run --diff --allow-risky=yes --config=.php-cs-fixer.php",
    "cs:fix": "@php vendor/bin/php-cs-fixer fix --allow-risky=yes --config=.php-cs-fixer.php",
    "stan": "@php vendor/bin/phpstan analyse --memory-limit=4G --configuration=phpstan.neon",
    "test": "@php vendor/bin/phpunit --configuration=phpunit.xml.dist",
    "qa": ["@cs:check", "@stan", "@test"]
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.94",
    "phpstan/phpstan": "2.3.0",
    "phpstan/phpstan-strict-rules": "2.1.0",
    "phpunit/phpunit": "^10.5"
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
